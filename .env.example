# Courtesy Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Backend ───────────────────────────────────────────────
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-secret

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ─── Database (deferred — not used in starter slice) ──────
# DATABASE_URL=postgresql://user:password@localhost:5432/courtesy_db
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ─── AI_Tool Bridge (deferred — not used in starter slice)
# AITOOL_API_BASE_URL=http://localhost:5001/api
# AITOOL_API_KEY=your-api-key-here

# ─── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:5000/api
